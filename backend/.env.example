PORT=3001

# DB
MONGODB_URI=mongodb://localhost:27017/aio-music

# Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Spotify
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# YouTube
YOUTUBE_API_KEY=your_youtube_api_key

# SoundCloud
SOUNDCLOUD_CLIENT_ID=your_soundcloud_client_id

# YouTube streaming — optional but strongly recommended to avoid 403 errors
# Export cookies from your browser (Chrome: use "Get cookies.txt LOCALLY" extension)
# while logged in to youtube.com, then set the path here.
# If left empty, backend defaults to looking for backend/cookies.txt
YT_COOKIES_PATH=
